{
  "name": "@neurcode-ai/share",
  "version": "0.3.0",
  "description": "Local-first deterministic code-context capture, review, export, and secure Neurcode Share publishing",
  "bin": {
    "neurcode-share": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "test": "tsx --test src/share/share-local.test.ts src/share/composer.test.ts src/share/verification.test.ts",
    "prepack": "pnpm build"
  },
  "keywords": [
    "code-sharing",
    "context",
    "provenance",
    "ai-agent",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Neurcode AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurcode-ai/share.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/neurcode-ai/share/issues"
  },
  "homepage": "https://github.com/neurcode-ai/share#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@neurcode-ai/share-format": "workspace:*",
    "commander": "^11.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
